{
  "name": "fluentcart-mcp",
  "version": "2.0.0",
  "description": "MCP server for the FluentCart REST API \u2014 AI-agent-friendly tools for managing orders, products, customers, subscriptions, and more.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fluentcart-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:integration:local": "node scripts/run-live-tests.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build:contract": "node scripts/build-release-contract.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "check:contract": "node scripts/build-release-contract.mjs --check",
    "check:manifest": "node scripts/build-manifest.mjs --check",
    "capture:read-contracts": "node scripts/capture-read-contracts.mjs",
    "check:routes": "node scripts/check-tool-routes.mjs",
    "measure:context": "node scripts/measure-tool-context.mjs",
    "check:compatibility": "node scripts/check-tool-routes.mjs --compatibility",
    "prepublishOnly": "npm run build",
    "pack:mcpb": "node scripts/build-mcpb.mjs",
    "pack:release": "node scripts/build-release-artifacts.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fluentcart",
    "wordpress",
    "ecommerce",
    "ai",
    "agent",
    "orders",
    "products",
    "subscriptions"
  ],
  "author": "Vibe Code <hello@vcode.sh>",
  "license": "MIT",
  "homepage": "https://github.com/vcode-sh/fchub-plugins/tree/main/fluentcart-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcode-sh/fchub-plugins.git",
    "directory": "fluentcart-mcp"
  },
  "bugs": {
    "url": "https://github.com/vcode-sh/fchub-plugins/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@jitl/quickjs-wasmfile-release-asyncify": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "^2.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "gpt-tokenizer": "3.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "hono": "4.12.32",
    "@hono/node-server": "1.19.15",
    "fast-uri": "3.1.4",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3",
    "body-parser": "2.3.0",
    "express-rate-limit": "8.6.0"
  }
}
