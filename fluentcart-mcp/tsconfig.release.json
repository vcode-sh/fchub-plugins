{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-packages/release-dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSourceMap": false,
    "inlineSources": false,
    "removeComments": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "dist-packages", "tests", "scripts"]
}
