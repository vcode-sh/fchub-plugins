# Release image. It copies an already-validated runtime tree and builds nothing: no npm install,
# no TypeScript compile. The context archive is produced and checksummed by
# scripts/build-release-artifacts.mjs, so whatever ships here is exactly what was inspected.
FROM node:24-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY dist ./dist
COPY node_modules ./node_modules
COPY package.json ./
COPY release-contract.json ./

LABEL org.opencontainers.image.title="FluentCart MCP Server"
LABEL org.opencontainers.image.description="Capability-discovered MCP tools for managing a FluentCart store via the Model Context Protocol"
LABEL org.opencontainers.image.source="https://github.com/vcode-sh/fchub-plugins"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="Vibe Code"
LABEL org.opencontainers.image.url="https://fchub.co/docs/fluentcart-mcp"

EXPOSE 3000

USER node

# Binding 0.0.0.0 is a non-loopback exposure, so the server refuses to start unless
# FLUENTCART_MCP_API_KEY is injected at run time with at least 32 characters. Pass it with
# `-e FLUENTCART_MCP_API_KEY=...`; it is deliberately never baked into the image.
CMD ["node", "dist/index.js", "--transport", "http", "--port", "3000", "--host", "0.0.0.0"]
