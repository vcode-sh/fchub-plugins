# Live tests read only .env.test.local from this directory.
# Copy this file to that exact name, fill it in, then run:
#   chmod 600 .env.test.local
#   npm run test:integration:local
#
# Localhost targets are allowed by default. A remote target is refused unless you also set the
# remote-origin opt-in and the target fingerprint documented by scripts/live-target-policy.mjs.
FLUENTCART_URL="https://your-store.com"
FLUENTCART_USERNAME="admin"
FLUENTCART_APP_PASSWORD="aBcD eFgH iJkL mNoP qRsT uVwX"

# Optional local Core+Pro Abilities proof. The launcher creates and cleans a run-owned subscriber
# and Application Password. Store only the opt-in here; never store Abilities credentials.
# FLUENTCART_ABILITIES_MODE="enabled"

# Remote targets only:
# FLUENTCART_INTEGRATION_ALLOW_REMOTE="yes"
# FLUENTCART_INTEGRATION_REMOTE_ORIGIN="https://your-store.com"
# Paste the bare 64-character lowercase hexadecimal value reported by the launcher. Do not add
# a "sha256:" prefix: the value below is compared byte for byte.
# FLUENTCART_INTEGRATION_TARGET_FINGERPRINT="<64 lowercase hexadecimal characters>"
