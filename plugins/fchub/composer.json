{
    "name": "fchub/fchub",
    "description": "FCHub product centre plugin development tooling",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "FChubHub\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FChubHub\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    }
}
