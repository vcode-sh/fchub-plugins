<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache" colors="true">
    <testsuites>
        <testsuite name="FCHub">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">app/Catalogue</directory>
            <directory suffix=".php">app/Core</directory>
            <directory suffix=".php">app/Http</directory>
            <directory suffix=".php">app/Operations</directory>
            <directory suffix=".php">app/Support</directory>
        </include>
    </source>
</phpunit>
