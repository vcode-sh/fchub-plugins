.git/
.gitignore
.distignore
node_modules/
vendor/
tests/
smoke/
resources/admin/
# A build input, not a shipped asset: Vite emits its own hashed copy into
# assets/dist/, and the built stylesheet is the only thing that references it.
assets/fonts/
# The hub carries a namespaced updater in app/Support/, so a lib/ here could only
# be the shared GitHubUpdater arriving by accident. The release workflow already
# declines to sync it; this makes the archive correct by construction rather than
# by workflow condition. Anchored, so a lib/ nested anywhere legitimate survives.
/lib/
.phpunit.cache/
test-results/
composer.json
composer.lock
package.json
package-lock.json
vite.config.js
playwright.config.js
phpunit.xml
phpunit.xml.dist
*.md
.DS_Store
Thumbs.db
