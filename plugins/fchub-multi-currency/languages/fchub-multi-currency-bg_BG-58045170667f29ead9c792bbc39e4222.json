{"translation-revision-date":"2026-08-19 01:48+0300","generator":"WP-CLI\/2.12.0","source":"admin\/components\/checkout-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"bg_BG","plural-forms":"nplurals=2; plural=(n != 1);"},"Checkout Disclosure":["\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043f\u043b\u0430\u0449\u0430\u043d\u0435"],"Show a notice at checkout that payment is processed in the base currency.":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430 \u043f\u0440\u0438 \u043f\u043b\u0430\u0449\u0430\u043d\u0435 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435, \u0447\u0435 \u043f\u043b\u0430\u0449\u0430\u043d\u0435\u0442\u043e \u0441\u0435 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0432\u0430 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0430\u0442\u0430 \u0432\u0430\u043b\u0443\u0442\u0430."],"Enabled":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u043e"],"Disabled":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u043e"],"Disclosure Text":["\u0422\u0435\u043a\u0441\u0442 \u043d\u0430 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435\u0442\u043e"],"Supports placeholders: {base_currency}, {display_currency}, {rate}":["\u041f\u043e\u0434\u0434\u044a\u0440\u0436\u0430 \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u0438: {base_currency}, {display_currency}, {rate}"],"Rate Freshness Badge":["\u0417\u043d\u0430\u0447\u043a\u0430 \u0437\u0430 \u0430\u043a\u0442\u0443\u0430\u043b\u043d\u043e\u0441\u0442 \u043d\u0430 \u043a\u0443\u0440\u0441\u043e\u0432\u0435\u0442\u0435"],"Global gate for the rates-updated badge. When disabled, no surface shows it \u2014 including the switcher dropdown footer.":["\u041e\u0431\u0449 \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b \u0437\u0430 \u0437\u043d\u0430\u0447\u043a\u0430\u0442\u0430 \u0441 \u0432\u0440\u0435\u043c\u0435\u0442\u043e \u043d\u0430 \u043e\u04