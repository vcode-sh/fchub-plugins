{"translation-revision-date":"2026-08-19 01:48+0300","generator":"WP-CLI\/2.12.0","source":"admin\/components\/general-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"bg_BG","plural-forms":"nplurals=2; plural=(n != 1);"},"Geolocation":["\u0413\u0435\u043e\u043b\u043e\u043a\u0430\u0446\u0438\u044f"],"Select currency":["\u0418\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u0432\u0430\u043b\u0443\u0442\u0430"],"Master switch for display-layer multi-currency across the store.":["\u0413\u043b\u0430\u0432\u0435\u043d \u043f\u0440\u0435\u0432\u043a\u043b\u044e\u0447\u0432\u0430\u0442\u0435\u043b \u0437\u0430 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0446\u0435\u043d\u0438 \u0432 \u043d\u044f\u043a\u043e\u043b\u043a\u043e \u0432\u0430\u043b\u0443\u0442\u0438 \u0432 \u0446\u0435\u043b\u0438\u044f \u043c\u0430\u0433\u0430\u0437\u0438\u043d."],"Enabled":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u043e"],"Disabled":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u043e"],"Base Currency":["\u041e\u0441\u043d\u043e\u0432\u043d\u0430 \u0432\u0430\u043b\u0443\u0442\u0430"],"Same as base currency (%s) \u2014 recommended":["\u0421\u044a\u0449\u0430\u0442\u0430 \u043a\u0430\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u0430\u0442\u0430 \u0432\u0430\u043b\u0443\u0442\u0430 (%s) \u2014 \u043f\u0440\u0435\u043f\u043e\u0440\u044a\u0447\u0438\u0442\u0435\u043b\u043d\u043e"],"store base":["\u043e\u0441\u043d\u043e\u0432\u043d\u0430 \u0432\u0430\u043b\u0443\u0442\u0430 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430"],"Multi-Currency Enabled":["\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0432\u0430\u043b\u0443\u0442\u0438"],"Managed in FluentCart Store Setup. Checkout and payment gateways use this currency.":["\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0432\u0430 \u0441\u0435 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0432\u044a\u0432 FluentCart. \u041f\u043b\u0430\u0449\u0430\u043d\u0435\u0442\u043e \u0438 \u043f\u043b\u0430\u0442\u0435\u0436\u043d\u0438\u0442\u0435 \u0448\u043b\u044e\u0437\u043e\u0432\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442 \u0442\u0430\u0437\u0438 \u0432\u0430\u043b\u0443\u0442\u0430."],"Default Display Currency":["\u0412\u0430\u043b\u0443\u0442\u0430 \u0437\u0430 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043f\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043d\u0435"],"Currency shown to visitors before any preference is detected.":["\u0412\u0430\u043b\u0443\u0442\u0430\u0442\u0430, \u043a\u043e\u044f\u0442\u043e \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430 \u043d\u0430 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0438\u0442\u0435, \u043f\u0440\u0435\u0434\u0438 \u0434\u0430 \u0431\u044a\u0434\u0435 \u043e\u0442\u043a\u0440\u0438\u0442\u043e \u0442\u044f\u0445\u043d\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043d\u0438\u0435."],"URL Parameter":["URL \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u044a\u0440"],"Allow currency switching via URL (e.g. ?currency=EUR).":["\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u0441\u043c\u044f\u043d\u0430 \u043d\u0430 \u0432\u0430\u043b\u0443\u0442\u0430\u0442\u0430 \u0447\u0440\u0435\u0437 URL \u0430\u0434\u0440\u0435\u0441 (\u043d\u0430\u043f\u0440. ?currency=EUR)."],"URL Parameter Key":["\u041a\u043b\u044e\u0447 \u043d\u0430 URL \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u044a\u0440\u0430"],"Cookie Persistence":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435 \u0432 \u0431\u0438\u0441\u043a\u0432\u0438\u0442\u043a\u0430"],"Remember a guest currency in a cookie and matching browser-storage fallback. Disable this and logged-out visitors cannot keep a currency choice at all \u2014 the switch is reported as failed rather than silently ignored.":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430 \u0432\u0430\u043b\u0443\u0442\u0430\u0442\u0430 \u043d\u0430 \u0433\u043e\u0441\u0442\u0430 \u0432 \u0431\u0438\u0441\u043a\u0432\u0438\u0442\u043a\u0430 \u0438 \u0432 \u0441\u044a\u043e\u0442\u0432\u0435\u0442\u043d\u043e \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435 \u043d\u0430 \u0431\u0440\u0430\u0443\u0437\u044a\u0440\u0430. \u0410\u043a\u043e \u0438\u0437\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0442\u0430\u0437\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430, \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0438\u0442\u0435 \u0431\u0435\u0437 \u0432\u0445\u043e\u0434 \u0438\u0437\u043e\u0431\u0449\u043e \u043d\u044f\u043c\u0430 \u0434\u0430 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u0437\u0430\u043f\u0430\u0437\u044f\u0442 \u0438\u0437\u0431\u043e\u0440\u0430 \u0441\u0438 \u043d\u0430 \u0432\u0430\u043b\u0443\u0442\u0430 \u2014 \u0441\u043c\u044f\u043d\u0430\u0442\u0430 \u0449\u0435 \u0431\u044a\u0434\u0435 \u043e\u0442\u0447\u0435\u0442\u0435\u043d\u0430 \u043a\u0430\u0442\u043e \u043d\u0435\u0443\u0441\u043f\u0435\u0448\u043d\u0430, \u0432\u043c\u0435\u0441\u0442\u043e \u0434\u0430 \u0431\u044a\u0434\u0435 \u043f\u0440\u0435\u043d\u0435\u0431\u0440\u0435\u0433\u043d\u0430\u0442\u0430 \u0431\u0435\u0437 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435."],"Currency switching is now a logged-in-only feature. Guests will be told their preference could not be saved.":["\u0421\u043c\u044f\u043d\u0430\u0442\u0430 \u043d\u0430 \u0432\u0430\u043b\u0443\u0442\u0430\u0442\u0430 \u0432\u0435\u0447\u0435 \u0435 \u0434\u043e\u0441\u0442\u044a\u043f\u043d\u0430 \u0441\u0430\u043c\u043e \u0437\u0430 \u0432\u043b\u0435\u0437\u043b\u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438. \u0413\u043e\u0441\u0442\u0438\u0442\u0435 \u0449\u0435 \u0431\u044a\u0434\u0430\u0442 \u0443\u0432\u0435\u0434\u043e\u043c\u0435\u043d\u0438, \u0447\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043d\u0438\u0435\u0442\u043e \u0438\u043c \u043d\u0435 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0431\u044a\u0434\u0435 \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u043e."],"Cookie Lifetime (days)":["\u0421\u0440\u043e\u043a \u043d\u0430 \u0431\u0438\u0441\u043a\u0432\u0438\u0442\u043a\u0430\u0442\u0430 (\u0434\u043d\u0438)"],"Account Persistence":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435 \u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u0430"],"Remember currency preference in the logged-in user account. Disable this if you want logged-in sessions to respect the default display currency on every fresh visit.":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043d\u0430\u0442\u0430 \u0432\u0430\u043b\u0443\u0442\u0430 \u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u0430 \u043d\u0430 \u0432\u043b\u0435\u0437\u043b\u0438\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b. \u0418\u0437\u043a\u043b\u044e\u0447\u0435\u0442\u0435 \u0442\u0430\u0437\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430, \u0430\u043a\u043e \u0438\u0441\u043a\u0430\u0442\u0435 \u043f\u0440\u0438 \u0432\u0441\u044f\u043a\u043e \u043d\u043e\u0432\u043e \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435 \u0441\u0435\u0441\u0438\u044f\u0442\u0430 \u0434\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u0432\u0430\u043b\u0443\u0442\u0430\u0442\u0430 \u0437\u0430 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043f\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043d\u0435."],"Coming Soon":["\u041e\u0447\u0430\u043a\u0432\u0430\u0439\u0442\u0435 \u0441\u043a\u043e\u0440\u043e"],"Automatically detect visitor currency based on their country. Requires a geolocation provider.":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0440\u0430\u0437\u043f\u043e\u0437\u043d\u0430\u0432\u0430 \u0432\u0430\u043b\u0443\u0442\u0430\u0442\u0430 \u043d\u0430 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044f \u0441\u043f\u043e\u0440\u0435\u0434 \u0434\u044a\u0440\u0436\u0430\u0432\u0430\u0442\u0430 \u043c\u0443. \u0418\u0437\u0438\u0441\u043a\u0432\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u0447\u0438\u043a \u043d\u0430 \u0433\u0435\u043e\u043b\u043e\u043a\u0430\u0446\u0438\u044f."],"Remove Data on Uninstall":["\u041f\u0440\u0435\u043c\u0430\u0445\u0432\u0430\u043d\u0435 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435 \u043f\u0440\u0438 \u0434\u0435\u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0435"],"If enabled, all tables and settings will be removed when the plugin is uninstalled.":["\u0410\u043a\u043e \u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0432\u0441\u0438\u0447\u043a\u0438 \u0442\u0430\u0431\u043b\u0438\u0446\u0438 \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0449\u0435 \u0431\u044a\u0434\u0430\u0442 \u043f\u0440\u0435\u043c\u0430\u0445\u043d\u0430\u0442\u0438 \u043f\u0440\u0438 \u0434\u0435\u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0440\u0430\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0435\u0442\u043e."],"Keep data":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435"],"Delete all":["\u0418\u0437\u0442\u0440\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u0441\u0438\u0447\u043a\u043e"]}}}