{"translation-revision-date":"2026-08-19 02:32+0300","generator":"WP-CLI\/2.12.0","source":"admin\/components\/checkout-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"el","plural-forms":"nplurals=2; plural=(n != 1);"},"Checkout Disclosure":["\u0395\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03ae\u03c1\u03c9\u03c3\u03b7 \u03b1\u03b3\u03bf\u03c1\u03ac\u03c2"],"Show a notice at checkout that payment is processed in the base currency.":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7\u03c2 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03ae\u03c1\u03c9\u03c3\u03b7 \u03b1\u03b3\u03bf\u03c1\u03ac\u03c2 \u03cc\u03c4\u03b9 \u03b7 \u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ae \u03b4\u03b9\u03b5\u03ba\u03c0\u03b5\u03c1\u03b1\u03b9\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03b2\u03b1\u03c3\u03b9\u03ba\u03cc \u03bd\u03cc\u03bc\u03b9\u03c3\u03bc\u03b1."],"Enabled":["\u0395\u03bd\u03b5\u03c1\u03b3\u03cc"],"Disabled":["\u0391\u03bd\u03b5\u03bd\u03b5\u03c1\u03b3\u03cc"],"Disclosure Text":["\u039a\u03b5\u03af\u03bc\u03b5\u03bd\u03bf \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7\u03c2"],"Supports placeholders: {base_currency}, {display_currency}, {rate}":["\u03a5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03af\u03b6\u03b5\u03b9 \u03c3\u03cd\u03bc\u03b2\u03bf\u03bb\u03b1 \u03ba\u03c1\u03ac\u03c4\u03b7\u03c3\u03b7\u03c2 \u03b8\u03ad\u03c3\u03b7\u03c2: {base_currency}, {display_currency}, {rate}"],"Rate Freshness Badge":["\u0388\u03bd\u03b4\u03b5\u03b9\u03be\u03b7 \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7\u03c2 \u03b9\u03c3\u03bf\u03c4\u03b9\u03bc\u03b9\u03ce\u03bd"],"Global gate for the rates-updated badge. When disabled, no surface shows it \u2014 including the switcher dropdown footer.":["\u039a\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ae \u03c1\u03c