#. Description of the plugin
#: fchub-multi-currency.php
msgid ""
"Display-layer multi-currency for FluentCart with exchange rate management "
"and checkout disclosure"
msgstr ""
"Múltiplas moedas na camada de exibição do FluentCart, com gerenciamento de "
"taxas de câmbio e aviso na finalização da compra"

#. Author of the plugin
#: fchub-multi-currency.php
msgid "Vibe Code"
