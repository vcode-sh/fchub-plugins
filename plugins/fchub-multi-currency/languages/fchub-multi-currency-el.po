msgid "Truncate (no rounding)"
msgstr "Αποκοπή (χωρίς στρογγυλοποίηση)"

#: app/Domain/Enums/RoundingMode.php:21 admin/components/rate-settings.js:146
msgid "Round half up (standard)"
msgstr "Στρογγυλοποίηση του μισού προς τα πάνω (τυπική)"

#: app/Domain/Enums/RoundingMode.php:22 admin/components/rate-settings.js:149
msgid "Round half down"
msgstr "Στρογγυλοποίηση του μισού προς τα κάτω"

#: app/Domain/Enums/RoundingMode.php:23 admin/components/rate-settings.js:152
