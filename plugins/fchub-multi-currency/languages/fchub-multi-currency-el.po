msgstr "Πάντα στρογγυλοποίηση προς τα πάνω"

#: app/Domain/Enums/RoundingMode.php:24 admin/components/rate-settings.js:155
msgid "Always round down"
msgstr "Πάντα στρογγυλοποίηση προς τα κάτω"

