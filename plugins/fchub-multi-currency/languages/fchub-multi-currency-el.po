#. Description of the plugin
#: fchub-multi-currency.php
msgid ""
"Display-layer multi-currency for FluentCart with exchange rate management "
"and checkout disclosure"
msgstr ""
"Προβολή τιμών σε πολλαπλά νομίσματα για το FluentCart, με διαχείριση "
"ισοτιμιών και ενημέρωση κατά την ολοκλήρωση αγοράς"

#. Author of the plugin
#: fchub-multi-currency.php
msgid "Vibe Code"
msgstr "Vibe Code"

#. Author URI of the plugin
#: fchub-multi-currency.php
msgid "https://x.com/vcode_sh"
msgstr "https://x.com/vcode_sh"

#: app/Bootstrap/Modules/BlocksModule.php:81
msgid "Currency Showcase"
msgstr "Παρουσίαση νομισμάτων"

#: app/Bootstrap/Modules/BlocksModule.php:83
msgid "A ready-made showcase of the full currency block family."
msgstr "Μια έτοιμη παρουσίαση ολόκληρης της οικογένειας μπλοκ νομισμάτων."

#: app/Bootstrap/Modules/DiagnosticsModule.php:71
msgid ""
"FCHub Multi-Currency: Some exchange rates are stale. Check the diagnostics "
"page or trigger a manual refresh."
msgstr ""
"FCHub Multi-Currency: Ορισμένες ισοτιμίες δεν είναι ενημερωμένες. Ελέγξτε τη "
"σελίδα διαγνωστικών ή ξεκινήστε μη αυτόματη ανανέωση."

#: app/Domain/Actions/SaveManualRatesAction.php:37
msgid "Switch the rate provider to Manual rates before saving."
msgstr ""
"Αλλάξτε τον πάροχο ισοτιμιών σε «Μη αυτόματες ισοτιμίες» πριν από την "
"αποθήκευση."

#: app/Domain/Actions/SaveManualRatesAction.php:43
msgid "Add at least one display currency before saving manual rates."
msgstr ""
"Προσθέστε τουλάχιστον ένα νόμισμα προβολής πριν αποθηκεύσετε μη αυτόματες "
"ισοτιμίες."

#: app/Domain/Actions/SaveManualRatesAction.php:48
msgid "Provide one rate for every configured display currency."
msgstr "Καταχωρίστε μία ισοτιμία για κάθε διαμορφωμένο νόμισμα προβολής."

#: app/Domain/Actions/SaveManualRatesAction.php:51
#: app/Domain/Actions/SaveManualRatesAction.php:98
msgid "Rates may only be saved for configured display currencies."
msgstr ""
"Μπορείτε να αποθηκεύσετε ισοτιμίες μόνο για διαμορφωμένα νομίσματα προβολής."

#: app/Domain/Actions/SaveManualRatesAction.php:67
#: app/Http/Controllers/Admin/RatesAdminController.php:104
#: admin/multi-currency-page.js:222
msgid "Manual rates could not be saved."
msgstr "Δεν ήταν δυνατή η αποθήκευση των μη αυτόματων ισοτιμιών."

#: app/Domain/Actions/SaveManualRatesAction.php:110
#: app/Domain/Actions/SaveManualRatesAction.php:117
msgid ""
"Each manual rate must be a positive decimal string with up to 8 decimal "
"places."
msgstr ""
"Κάθε μη αυτόματη ισοτιμία πρέπει να είναι θετικός δεκαδικός αριθμός με έως 8 "
"δεκαδικά ψηφία."

#: app/Domain/Actions/SaveManualRatesAction.php:121
msgid "Each manual rate must be greater than zero."
msgstr "Κάθε μη αυτόματη ισοτιμία πρέπει να είναι μεγαλύτερη από το μηδέν."

#: app/Domain/Enums/RateProvider.php:19 admin/components/rate-settings.js:52
