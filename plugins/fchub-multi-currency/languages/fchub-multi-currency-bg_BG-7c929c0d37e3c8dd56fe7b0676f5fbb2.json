430\u0442\u043e\u0440\u0430."],"Stale Rate Fallback":["\u0420\u0435\u0437\u0435\u0440\u0432\u0435\u043d \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043f\u0440\u0438 \u043e\u0441\u0442\u0430\u0440\u044f\u043b \u043a\u0443\u0440\u0441"],"What to do when rates are outdated beyond the threshold.":["\u041a\u0430\u043a\u0432\u043e \u0434\u0430 \u0441\u0435 \u043f\u0440\u0430\u0432\u0438, \u043a\u043e\u0433\u0430\u0442\u043e \u043a\u0443\u0440\u0441\u043e\u0432\u0435\u0442\u0435 \u0441\u0430 \u043f\u043e-\u0441\u0442\u0430\u0440\u0438 \u043e\u0442 \u0437\u0430\u0434\u0430\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u0433."],"Show base currency":["\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u0430\u0442\u0430 \u0432\u0430\u043b\u0443\u0442\u0430"],"Use last known rate":["\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u044f \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0443\u0440\u0441"],"Rounding Mode":["\u041c\u0435\u0442\u043e\u0434 \u043d\u0430 \u0437\u0430\u043a\u0440\u044a\u0433\u043b\u044f\u043d\u0435"],"How converted prices are rounded.":["\u041a\u0430\u043a \u0441\u0435 \u0437\u0430\u043a\u0440\u044a\u0433\u043b\u044f\u0442 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0432\u0430\u043d\u0438\u0442\u0435 \u0446\u0435\u043d\u0438."],"Charm Rounding":["\u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u043e \u0437\u0430\u043a\u0440\u044a\u0433\u043b\u044f\u0432\u0430\u043d\u0435"],"Round converted display prices to selling endings. Display-only, like every converted price; checkout still charges the base currency exactly.":["\u0417\u0430\u043a\u0440\u044a\u0433\u043b\u044f\u0439\u0442\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0438\u0442\u0435 \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u0438\u0440\u0430\u043d\u0438 \u0446\u0435\u043d\u0438 \u0434\u043e \u0442\u044a\u0