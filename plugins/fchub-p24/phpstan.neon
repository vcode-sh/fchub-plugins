includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - app
        - fchub-p24.php
    excludePaths:
        - app/*/index.php
    bootstrapFiles:
        - vendor/autoload.php
        - phpstan-bootstrap.php
    # The shared updater is vendored into every plugin and analysed in none of
    # them. Scanned, not analysed: PHPStan needs to know FCHub_GitHub_Updater
    # exists, without holding a deliberately global snake_cased class to the
    # standards of code we actually write.
    scanFiles:
        - lib/GitHubUpdater.php
        - phpstan-functions.php
    scanDirectories:
        - ../../../fchub-playground/wp-content/plugins/fluent-cart/app
        - ../../../fchub-playground/wp-content/plugins/fluent-cart/api
        - ../../../fchub-playground/wp-content/plugins/fluent-cart/vendor/wpfluent
    universalObjectCratesClasses:
        - FluentCart\App\Models\Order
        - FluentCart\App\Models\OrderTransaction
        - FluentCart\App\Models\Subscription
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
