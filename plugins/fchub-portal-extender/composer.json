{
    "name": "fchub/portal-extender",
    "description": "FCHub Portal Extender - Custom endpoints for the FluentCart customer portal",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "FChubPortalExtender\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FChubPortalExtender\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
