# Dependencies
node_modules/
vendor/
.phpunit.cache/
.phpunit.result.cache

# Build output - memberships assets/dist/ IS tracked
# (assets/dist/ is committed so plugin works without build step locally)

# IDE/OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Environment
.env
.env.*
!.env.example
!fluentcart-mcp/.env.test.local.example

# Local build output
/dist/

# Advisory locks held by build.sh while a plugin is being built
/.build-locks/

# Next.js / Fumadocs (web-docs)
.next/
.source/

# Playwright — local run state and failure artifacts.
# test-results/wporg/ at the root is tracked release evidence and stays tracked.
/plugins/*/test-results/
/plugins/*/playwright-report/
/plugins/*/blob-report/
# Browser-lane artefacts: regenerated on every run, never evidence on their own.
/plugins/*/tests/e2e/.output/
/plugins/*/tests/e2e/.report/
/plugins/*/tests/e2e/.fixture/
/fluentcart-mcp/test-results/
/.playwright-cli/

# Debug
*.log

# Agent workspace scratch (session tokens, task briefs, review packages)
/.superpowers/

# Local
.claude/
voice-tone.md
# Anchored: fluentcart-mcp/openai-plugin/.mcp.json is a shipped, tracked file.
/.mcp.json
CLAUDE.md
/docs/superpowers/
